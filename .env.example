# auto-morange - przykładowa konfiguracja (plik OPCJONALNY)
#
# Hasła, SMTP i selektory najprościej ustawić w panelu logowania - zapisze je do
# /data/config.env. Wartości wpisane TUTAJ mają pierwszeństwo przed panelem
# (panel pokaże je jako zablokowane).
#
# Użycie: cp .env.example .env && chmod 600 .env
# .env jest w .gitignore i .dockerignore - nie trafi do repo ani do obrazu.
# Format KEY=wartość, bez "export" i bez cudzysłowów (zgodny z docker --env-file).

# --- Docker Compose -------------------------------------------------------------------
# Wersja obrazu z ghcr.io/pprazzi99/auto-morange (latest, 1, 1.2, 1.2.3, sha-abc1234)
#AUTO_MORANGE_TAG=latest
# Gdzie trzymać dane: nazwa wolumenu Dockera albo katalog na hoście (./data -> chown 1000:1000)
#AUTO_MORANGE_DATA=./data
# Limit pamięci kontenera (Chromium potrzebuje ok. 0,5-1 GB na czas przebiegu)
#AUTO_MORANGE_MEM_LIMIT=1536m

# --- Harmonogram (tylko Docker; na hoście ustawiasz go w crontabie) ------------------
# min godz dzień-mies mies dzień-tyg; domyślnie 3. dnia miesiąca o 9:00
#CRON_SCHEDULE=0 9 3 * *
#TZ=Europe/Warsaw
# 1 = dodatkowo uruchom raz od razu po starcie kontenera
#RUN_ON_START=0

# --- Panel logowania ------------------------------------------------------------------
# Port na hoście (Docker) / port serwera (bez Dockera: LOGIN_PORT)
#LOGIN_HOST_PORT=8080
#LOGIN_PORT=8080
# Po ilu minutach bezczynności panel sam się wyłączy (0 = nigdy)
#LOGIN_IDLE_MINUTES=30
# Maks. klatek/s podglądu w panelu (mniej = lżej dla serwera)
#LOGIN_FPS=3

# --- Sekrety (zalecane: ustaw w panelu zamiast tutaj) -----------------------------------
#ORANGE_LOGIN=
#ORANGE_PASSWORD=
#SMTP_HOST=
#SMTP_PORT=465
#SMTP_USER=
#SMTP_PASS=
#MAIL_TO=
#MAIL_FROM=

# --- Inne -------------------------------------------------------------------------------
#LOG_LEVEL=INFO
# 1 = szczegółowe logi debug (nawigacja, błędy strony, czasy oczekiwania)
#DEBUG=0
# 1 = słabszy serwer: bez obrazków/fontów/mediów (~500 MB RAM zamiast ~900 MB) i dłuższe timeouty (rabat: 60 s)
#LOW_RESOURCES=1
# Strona sprawdzana po zalogowaniu (domyślnie usługi pakietowe)
#ORANGE_REWARD_URL=https://www.orange.pl/moj-orange/uslugi-pakietowe
# Katalog danych (bez Dockera; domyślnie ./data obok skryptu)
#DATA_DIR=
